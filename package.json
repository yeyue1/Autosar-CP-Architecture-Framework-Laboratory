{
  "name": "autosar-startup-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "零第三方依赖的 AUTOSAR Classic 启动、诊断、通信、存储、OS、标定与知识库检索学习实验室",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node scripts/check.mjs",
    "check:corpus": "node scripts/validate-corpus.mjs",
    "build:corpus": "node scripts/build-corpus.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:node": "node --test tests/*.test.mjs",
    "test:direct": "node scripts/run-tests.mjs",
    "verify": "node scripts/check.mjs && node scripts/validate-corpus.mjs && node scripts/run-tests.mjs",
    "verify:browser": "node scripts/browser-verify.mjs",
    "trace": "node scripts/export-trace.mjs"
  }
}
